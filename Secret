	makeToggle(camRow, UDim2.new(1, -12, 0, 20), "Camlock", function()
		return State.Camlock
	end, function()
		setCamlock(not State.Camlock)
	end)
	makeKeyChip(camRow, UDim2.new(1, -58, 0, 20), "Camlock")

	-- ESP
	local espRow = makeRow(list, 2, 40, "eye", "ESP")
	makeToggle(espRow, UDim2.new(1, -12, 0, 20), "ESP", function()
		return State.ESP
	end, function()
		setESP(not State.ESP)
	end)
	makeKeyChip(espRow, UDim2.new(1, -58, 0, 20), "ESP")

	-- Camera FOV
