		TextColor3 = Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.None,
		Parent = frame,
	})
	local image = create("ImageLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ImageTransparency = 1,
		ScaleType = Enum.ScaleType.Crop,
		Image = "",
		Parent = frame,
	}, { corner(radius) })
	table.insert(AvatarTargets, { Image = image, Initial = initial })
	return frame
end

local function applyAvatar(content)
	for _, target in ipairs(AvatarTargets) do
		if target.Image.Parent then
			target.Image.Image = content
			tween(target.Image, 0.35, { ImageTransparency = 0 }, "load")
			tween(target.Initial, 0.25, { TextTransparency = 1 }, "load")
		end
	end
end

local function loadThumbnail()
	for _ = 1, 3 do
		local ok, content, ready = pcall(function()
			return Players:GetUserThumbnailAsync(LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size180x180)
		end)
		if State.Unloaded then
			return
		end
		if ok and type(content) == "string" and content ~= "" then
			applyAvatar(content)
			if ready then
				return
			end
		elseif not ok then
			warn("[DigitalServices] Could not load profile picture: " .. tostring(content))
		end
		task.wait(1.5)
		if State.Unloaded then
			return
		end
	end
end

