------------------------------------------------------------------------
-- Visibility & dialog
------------------------------------------------------------------------
local visibilityToken = 0

local function setUIVisible(visible)
	if State.Unloaded or not State.MainReady or not UI.Holder then
		return
	end
	State.UIVisible = visible
	visibilityToken = visibilityToken + 1
	local token = visibilityToken
	local base = getBaseScale()
	if visible then
		if not UI.Holder.Visible then
			UI.HolderScale.Scale = base * 0.95
			UI.Holder.Visible = true
		end
		tween(UI.Window, VISIBILITY_TIME, { GroupTransparency = 0 }, "vis")
		tween(UI.HolderScale, VISIBILITY_TIME, { Scale = base }, "vis")
		tween(UI.Shadow, VISIBILITY_TIME, { ImageTransparency = 0.45 }, "vis")
	else
		stopListening()
		ActiveSlider = nil
		DragInfo = nil
		local focused = UserInputService:GetFocusedTextBox()
		if focused and focused:IsDescendantOf(UI.Holder) then
			focused:ReleaseFocus()
		end
		tween(UI.Window, VISIBILITY_TIME, { GroupTransparency = 1 }, "vis")
		tween(UI.HolderScale, VISIBILITY_TIME, { Scale = base * 0.95 }, "vis")
		tween(UI.Shadow, VISIBILITY_TIME, { ImageTransparency = 1 }, "vis")
		schedule(VISIBILITY_TIME + 0.02, function()
			if token == visibilityToken and not State.UIVisible and UI.Holder then
				UI.Holder.Visible = false
			end
		end)
	end
end

local dialogToken = 0

openDialog = function()
	if State.Unloaded or State.DialogOpen or not UI.Overlay then
		return
	end
	stopListening()
	State.DialogOpen = true
	dialogToken = dialogToken + 1
	UI.Overlay.Visible = true
	UI.DialogScale.Scale = 0.94
	tween(UI.Overlay, 0.2, { BackgroundTransparency = 0.45 }, "dialog")
	tween(UI.DialogCanvas, 0.2, { GroupTransparency = 0 }, "dialog")
	tween(UI.DialogScale, 0.22, { Scale = 1 }, "dialog")
end

closeDialog = function()
	if State.Unloaded or not State.DialogOpen or not UI.Overlay then
		return
	end
	State.DialogOpen = false
	dialogToken = dialogToken + 1
	local token = dialogToken
	tween(UI.Overlay, 0.16, { BackgroundTransparency = 1 }, "dialog")
	tween(UI.DialogCanvas, 0.16, { GroupTransparency = 1 }, "dialog")
	tween(UI.DialogScale, 0.16, { Scale = 0.96 }, "dialog")
	schedule(0.17, function()
		if token == dialogToken and not State.DialogOpen and UI.Overlay then
			UI.Overlay.Visible = false
		end
	end)
end

------------------------------------------------------------------------
-- Input (single listener set for the whole script)
------------------------------------------------------------------------
local Actions = {
	Camlock = function()
		setCamlock(not State.Camlock)
	end,
	ESP = function()
		setESP(not State.ESP)
	end,
	ToggleUI = function()
		setUIVisible(not State.UIVisible)
	end,
}

connect(UserInputService.InputBegan, function(input, gameProcessed)
	if State.Unloaded or input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end
	local keyCode = input.KeyCode
	if keyCode == Enum.KeyCode.Unknown then
		return
	end
	if State.Listening then
		if UserInputService:GetFocusedTextBox() then
			return
		end
		if keyCode == Enum.KeyCode.Escape then
			stopListening()
			toast("Keybind change cancelled", Theme.SubText)
		else
			tryAssign(State.Listening, keyCode)
		end
		return
	end
	if gameProcessed or UserInputService:GetFocusedTextBox() then
		return
	end
	for action, bound in pairs(State.Keybinds) do
		if bound == keyCode then
			Actions[action]()
			return
		end
	end
end)

connect(UserInputService.InputChanged, function(input)
	local t = input.UserInputType
	if t ~= Enum.UserInputType.MouseMovement and t ~= Enum.UserInputType.Touch then
		return
	end
	if ActiveSlider then
		ActiveSlider.Update(input.Position.X)
	elseif DragInfo and UI.Holder then
		local delta = input.Position - DragInfo.Start
		local origin = DragInfo.Origin
		local x, y = origin.X.Offset + delta.X, origin.Y.Offset + delta.Y
		if Camera then
			local vp = Camera.ViewportSize
			local scale = UI.HolderScale.Scale
			local maxX = vp.X / 2 + (WINDOW_W * scale) / 2 - 60			local maxY = vp.Y / 2 + (WINDOW_H * scale) / 2 - 40
			x = math.clamp(x, -maxX, maxX)
			y = math.clamp(y, -maxY, maxY)
		end
		UI.Holder.Position = UDim2.new(origin.X.Scale, x, origin.Y.Scale, y)
	end
end)

connect(UserInputService.InputEnded, function(input)
	local t = input.UserInputType
	if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
		if ActiveSlider then
			ActiveSlider.Release()
			ActiveSlider = nil
		end
		DragInfo = nil
	end
end)

connect(Players.PlayerRemoving, function(player)
	if player == Camlock.Target then
		setCamlock(false, "Target left the game")
	end
	removeEspEntry(player)
end)

connect(Workspace:GetPropertyChangedSignal("CurrentCamera"), function()
	hookCamera(Workspace.CurrentCamera)
end)

local LocalDeathConn = nil
local function watchLocalCharacter(character)
	if LocalDeathConn then
		LocalDeathConn:Disconnect()
		LocalDeathConn = nil
	end
	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
	if State.Unloaded or not humanoid or LocalPlayer.Character ~= character then
		return
	end
	LocalDeathConn = humanoid.Died:Connect(function()
		if State.Camlock then
			setCamlock(false, "You died")
		end
	end)
end

connect(LocalPlayer.CharacterAdded, function(character)
	if State.Camlock then
		setCamlock(false, "You respawned")
	end
	task.spawn(watchLocalCharacter, character)
	schedule(0.15, function()
		applyFov(false)
	end)
end)
task.spawn(watchLocalCharacter, LocalPlayer.Character)

------------------------------------------------------------------------
-- Unload (idempotent, safe to call once or many times)
------------------------------------------------------------------------
local function safe(fn)
	local ok, err = pcall(fn)
	if not ok then
		warn("[DigitalServices] cleanup step failed: " .. tostring(err))
	end
end

Unload = function(immediate)
	if State.Unloaded then
		return
	end
	State.Unloaded = true
	if GlobalEnv.DigitalServicesUnload == Unload then
		GlobalEnv.DigitalServicesUnload = nil
	end

	-- 1-2. Disable features and stop camera tracking
	safe(stopCamlockTracking)
	safe(stopESP)
	State.Camlock = false
	State.ESP = false

	-- 3-4. Cancel scheduled threads and animations
	for _, thread in ipairs(Threads) do
		pcall(task.cancel, thread)
	end
	Threads = {}
	for _, bucket in pairs(TweenRegistry) do
		for _, t in pairs(bucket) do
			pcall(function()
				t:Cancel()
			end)
		end
	end
	TweenRegistry = {}

	-- 5-6. Restore camera
	safe(restoreFov)

	-- Disconnect every connection
	for _, c in ipairs(Connections) do
		pcall(function()
			c:Disconnect()
		end)
	end
	Connections = {}
	for _, c in ipairs(CameraConns) do
		pcall(function()
			c:Disconnect()
		end)
	end
	CameraConns = {}
	if LocalDeathConn then
		pcall(function()
			LocalDeathConn:Disconnect()
		end)
		LocalDeathConn = nil
	end
	Listeners = {}
	ActiveSlider = nil
	DragInfo = nil

	-- Remove any ESP visuals / render bindings that might still exist
	safe(sweepLeftovers)

	-- 7-8. Destroy interfaces
	local greeting, main, window, shadow = UI.Greeting, UI.Main, UI.Window, UI.Shadow
	safe(function()
		if greeting then
			greeting:Destroy()
		end
	end)
	if main then
		if immediate or not window or not window.Parent then
			safe(function()
				main:Destroy()
			end)
			safe(function()
				sweepLeftovers(true)
			end)
		else
			safe(function()
				-- Block every click while the window fades out
				local blocker = Instance.new("TextButton")
				blocker.Text = ""
				blocker.BackgroundTransparency = 1
				blocker.Size = UDim2.fromScale(1, 1)
				blocker.ZIndex = 1000
				blocker.Parent = main
				TweenService:Create(window, TweenInfo.new(0.18, Enum.EasingStyle.Quint), { GroupTransparency = 1 }):Play()
				if shadow then
					TweenService:Create(shadow, TweenInfo.new(0.18, Enum.EasingStyle.Quint), { ImageTransparency = 1 }):Play()
				end
			end)
			task.delay(0.2, function()
				pcall(function()
					main:Destroy()
				end)
				pcall(sweepLeftovers, true)
			end)
		end
	end

	-- 9. Reset state to defaults
	UI = {}
	KeyChips = {}
	AvatarTargets = {}
	ESP.Entries = {}
	State.FovEnabled = true
	State.FOV = Limits.FOV.Default
	State.Range = Limits.Range.Default
	State.Keybinds = copyDefaults()
	State.UIVisible = false
	State.MainReady = false
	State.DialogOpen = false
	State.Listening = nil
	Camera = nil
end

GlobalEnv.DigitalServicesUnload = Unload

------------------------------------------------------------------------
-- Boot
------------------------------------------------------------------------
local function showMain()
	if State.Unloaded or not UI.Holder then
		return
	end
	State.MainReady = true
	State.UIVisible = false
	setUIVisible(true)
end

local function runGreeting()
	tween(UI.GreetingCanvas, 0.45, { GroupTransparency = 0 }, "fade")
	tween(UI.GreetingScale, 0.5, { Scale = 1 }, "scale")
	tween(UI.GreetingShadow, 0.45, { ImageTransparency = 0.45 }, "fade")
	tween(UI.GreetingProgress, GREETING_DURATION, { Size = UDim2.fromScale(1, 1) }, "progress", Enum.EasingStyle.Linear)
	schedule(GREETING_DURATION, function()
		tween(UI.GreetingCanvas, 0.3, { GroupTransparency = 1 }, "fade")
		tween(UI.GreetingScale, 0.3, { Scale = 1.03 }, "scale")
		tween(UI.GreetingShadow, 0.3, { ImageTransparency = 1 }, "fade")
		showMain()
		schedule(0.32, function()
			if UI.Greeting then
				UI.Greeting:Destroy()
				UI.Greeting = nil
			end
		end)
	end)
end

while not Workspace.CurrentCamera do
	task.wait()
end
hookCamera(Workspace.CurrentCamera)

buildGreeting()
buildMainWindow()
Threads[#Threads + 1] = task.spawn(loadThumbnail)
runGreeting()
