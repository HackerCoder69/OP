UIS.InputBegan:Connect(function(input, gameProcessed)

	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end

	if waitingForUIKey then
		if input.KeyCode ~= Enum.KeyCode.Unknown then
			uiToggleKeybind = input.KeyCode
			waitingForUIKey = false
			updateUI()
		end
		return
	end

	if waitingForCamKey then
		if input.KeyCode ~= Enum.KeyCode.Unknown then
			camKeybind = input.KeyCode
			waitingForCamKey = false
			updateUI()
		end
		return
	end

	if waitingForESPKey then
		if input.KeyCode ~= Enum.KeyCode.Unknown then
			espKeybind = input.KeyCode
			waitingForESPKey = false
			updateUI()
		end
		return
	end

	if input.KeyCode == uiToggleKeybind then
		toggleUIVisibility()
		return
	end

	if gameProcessed then
		return
	end

	if not systemEnabled then
		return
	end

	if input.KeyCode == camKeybind then
		toggleCamLock()
		return
	end

	if input.KeyCode == espKeybind then
		toggleESP()
		return
	end
end)

