------------------------------------------------------------
-- UPDATE ESP
------------------------------------------------------------

local function updateESP(target)
	local data = ESPObjects[target]

	if not data then
		return
	end

	local character = target.Character

	if not character then
		data.gui.Enabled = false
		return
	end

	local humanoid = getHumanoid(character)
	local head = getPart(character, "Head")
	local root = getPart(character, "HumanoidRootPart")

	if not humanoid or humanoid.Health <= 0 then
		data.gui.Enabled = false
		return
	end

	if not head or not root then
		data.gui.Enabled = false
		return
	end

	if not systemEnabled or not espEnabled then
		data.gui.Enabled = false
		return
	end

	local distance = getDistance(target)

	if distance > MAX_DISTANCE then
		data.gui.Enabled = false
		return
	end

	data.gui.Enabled = true

	-- Always white
	data.stroke.Color = ENEMY_COLOR
	data.glow1.Color = ENEMY_COLOR
	data.glow2.Color = ENEMY_COLOR
	data.distance.TextColor3 = Color3.fromRGB(255, 255, 255)

	data.name.Text =
		target.DisplayName
		.. "\n@"
		.. target.Name

	data.distance.Text =
		math.floor(distance)
		.. " studs"
end

