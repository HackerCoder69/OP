local Threads = {}          -- every scheduled thread
local TweenRegistry = {}    -- [instance][tag] = Tween
local Listeners = {}        -- signal name -> callbacks

------------------------------------------------------------------------
-- Core utilities
------------------------------------------------------------------------
local function connect(signal, fn)
	local c = signal:Connect(function(...)
		if State.Unloaded then
			return
		end
		fn(...)
	end)
	Connections[#Connections + 1] = c
	return c
end

local function schedule(seconds, fn)
	local thread = task.delay(seconds, function()
		if not State.Unloaded then
			fn()
		end
	end)
	Threads[#Threads + 1] = thread
	return thread
end

local function tween(inst, duration, props, tag, style, direction)
	if not inst then
		return nil
	end
	tag = tag or "default"
	local bucket = TweenRegistry[inst]
	if not bucket then
		bucket = {}
		TweenRegistry[inst] = bucket
	end
	local previous = bucket[tag]
	if previous then
		previous:Cancel()
	end
	local info = TweenInfo.new(duration, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out)
	local t = TweenService:Create(inst, info, props)
	bucket[tag] = t
	t:Play()
	return t
end

local function cancelTween(inst, tag)
	local bucket = TweenRegistry[inst]
	if bucket and bucket[tag] then
		bucket[tag]:Cancel()
		bucket[tag] = nil
	end
end

local function subscribe(name, fn)
	Listeners[name] = Listeners[name] or {}
	table.insert(Listeners[name], fn)
end

local function emit(name, ...)
	local list = Listeners[name]
	if not list then
		return
	end
	for _, fn in ipairs(list) do
		local ok, err = pcall(fn, ...)
		if not ok then
			warn("[DigitalServices] " .. name .. " listener error: " .. tostring(err))
		end
	end
end

local function clampNumber(value, minValue, maxValue)
	value = tonumber(value)
	if not value or value ~= value or value == math.huge or value == -math.huge then
		return nil
	end
	return math.clamp(math.floor(value + 0.5), minValue, maxValue)
end

local function keyName(keyCode)
	return KeyLabels[keyCode.Name] or string.upper(keyCode.Name)
end

local function create(className, props, children)
	local inst = Instance.new(className)
	local parent
	if props then
		for key, value in pairs(props) do
			if key == "Parent" then
				parent = value
			else
				inst[key] = value
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

