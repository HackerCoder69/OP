------------------------------------------------------------------------
-- Keybind chips ("PRESS" listening mode)
------------------------------------------------------------------------
local KeyChips = {}
local conflictToken = {}

local function renderKeyChip(action)
	local kb = KeyChips[action]
	if not kb then
		return
	end
	local listening = State.Listening == action
	kb.Button.Text = listening and "PRESS" or keyName(State.Keybinds[action])
	tween(kb.Stroke, 0.15, { Color = listening and Theme.Accent or Theme.Border }, "color")
	tween(kb.Button, 0.15, { TextColor3 = listening and Theme.Accent or Theme.SubText }, "color")
end

local function stopListening()
	local action = State.Listening
	State.Listening = nil
	if action then
		renderKeyChip(action)
	end
end

local function startListening(action)
	if State.Listening == action then
		stopListening()
		return
	end
	stopListening()
	local focused = UserInputService:GetFocusedTextBox()
	if focused then
		focused:ReleaseFocus()
	end
	State.Listening = action
	renderKeyChip(action)
end

local function flashConflict(action, other)
	local kb = KeyChips[action]
	if not kb then
		return
	end
	conflictToken[action] = (conflictToken[action] or 0) + 1
	local token = conflictToken[action]
	kb.Button.Text = keyName(State.Keybinds[action])
	tween(kb.Stroke, 0.12, { Color = Theme.Danger }, "color")
	tween(kb.Button, 0.12, { TextColor3 = Theme.Danger }, "color")
	toast("Key already used by " .. ActionNames[other], Theme.Danger)
	schedule(1.4, function()
		if conflictToken[action] == token and State.Listening ~= action then
			renderKeyChip(action)
		end
	end)
end

local function tryAssign(action, keyCode)
	for other, bound in pairs(State.Keybinds) do
		if other ~= action and bound == keyCode then
			State.Listening = nil
			flashConflict(action, other)
			return
		end
	end
	State.Keybinds[action] = keyCode
	stopListening()
	toast(ActionNames[action] .. " set to " .. keyName(keyCode))
end

local function makeKeyChip(parent, position, action)
	local chip = create("TextButton", {
		Name = "Keybind",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = position,
		Size = UDim2.fromOffset(0, 24),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Theme.Secondary,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Font = Fonts.Bold,
		TextSize = 11,
		TextColor3 = Theme.SubText,
		Text = keyName(State.Keybinds[action]),
		Parent = parent,
	}, {
		corner(6),
		padding(0, 9, 0, 9),
		create("UISizeConstraint", { MinSize = Vector2.new(38, 24) }),
	})
	local chipStroke = stroke(Theme.Border)
	chipStroke.Parent = chip
	KeyChips[action] = { Button = chip, Stroke = chipStroke }
	connect(chip.MouseEnter, function()
		tween(chip, 0.15, { BackgroundColor3 = Theme.RowHover }, "hover")
	end)
	connect(chip.MouseLeave, function()
		tween(chip, 0.2, { BackgroundColor3 = Theme.Secondary }, "hover")
	end)
	connect(chip.Activated, function()
		startListening(action)
	end)
	return chip
end

