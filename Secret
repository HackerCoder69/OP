local function setSwitch(toggle, on)
	local glow = toggle:FindFirstChild("Glow")
	local knob = toggle:FindFirstChild("Knob")
	if on then
		TweenService:Create(toggle, TweenInfo.new(0.2), {BackgroundColor3 = COLORS.White}):Play()
		if knob then
			TweenService:Create(knob, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(1, -23, 0.5, -10), BackgroundColor3 = COLORS.Black}):Play()
		end
		if glow then TweenService:Create(glow, TweenInfo.new(0.2), {Transparency = 0.45}):Play() end
	else
		TweenService:Create(toggle, TweenInfo.new(0.2), {BackgroundColor3 = COLORS.Off}):Play()
		if knob then
			TweenService:Create(knob, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0, 3, 0.5, -10), BackgroundColor3 = COLORS.TextDim}):Play()
		end
		if glow then TweenService:Create(glow, TweenInfo.new(0.2), {Transparency = 1}):Play() end
	end
end

local function updateUI()

	if systemEnabled then
		status.Text = "System: Enabled"
		status.TextColor3 = COLORS.Success
		systemButton.Text = "SYSTEM ON"
		systemButton.TextColor3 = COLORS.Black

		TweenService:Create(
			systemButton,
			TweenInfo.new(0.15),
			{BackgroundColor3 = COLORS.White}
		):Play()
		TweenService:Create(systemButtonGlow, TweenInfo.new(0.15), {Transparency = 0.55}):Play()
		TweenService:Create(statusPill, TweenInfo.new(0.15), {BackgroundColor3 = COLORS.White}):Play()
		TweenService:Create(statusPillGlow, TweenInfo.new(0.15), {Transparency = 0.65}):Play()
	else
		status.Text = "System: Disabled"
		status.TextColor3 = COLORS.Error
		systemButton.Text = "SYSTEM OFF"
		systemButton.TextColor3 = COLORS.Text

		TweenService:Create(
			systemButton,
			TweenInfo.new(0.15),
			{BackgroundColor3 = COLORS.Off}
		):Play()
		TweenService:Create(systemButtonGlow, TweenInfo.new(0.15), {Transparency = 1}):Play()
		TweenService:Create(statusPill, TweenInfo.new(0.15), {BackgroundColor3 = COLORS.Error}):Play()
		TweenService:Create(statusPillGlow, TweenInfo.new(0.15), {Transparency = 1}):Play()
	end

	local camIconGlow = camIcon:FindFirstChildOfClass("UIStroke")
	if lockEnabled and systemEnabled then
		camStatus.Text = "Enabled"
		camStatus.TextColor3 = COLORS.White
		camIcon.BackgroundColor3 = COLORS.White
		setSwitch(camToggle, true)
		if camIconGlow then TweenService:Create(camIconGlow, TweenInfo.new(0.15), {Transparency = 0.6}):Play() end
	else
		camStatus.Text = "Disabled"
		camStatus.TextColor3 = COLORS.TextDim
		camIcon.BackgroundColor3 = COLORS.Border
		setSwitch(camToggle, false)
		if camIconGlow then TweenService:Create(camIconGlow, TweenInfo.new(0.15), {Transparency = 1}):Play() end
	end

	local espIconGlow = espIcon:FindFirstChildOfClass("UIStroke")
	if espEnabled and systemEnabled then
		espStatus.Text = "Enabled  •  " .. tostring(MAX_DISTANCE) .. " stud range"
		espStatus.TextColor3 = COLORS.White
		espIcon.BackgroundColor3 = COLORS.White
		setSwitch(espToggle, true)
		if espIconGlow then TweenService:Create(espIconGlow, TweenInfo.new(0.15), {Transparency = 0.6}):Play() end
	else
		espStatus.Text = "Disabled  •  " .. tostring(MAX_DISTANCE) .. " stud range"
		espStatus.TextColor3 = COLORS.TextDim
		espIcon.BackgroundColor3 = COLORS.Border
		setSwitch(espToggle, false)
		if espIconGlow then TweenService:Create(espIconGlow, TweenInfo.new(0.15), {Transparency = 1}):Play() end
	end

	if waitingForCamKey then
		camKeyButton.Text = "PRESS"
	else
		camKeyButton.Text = camKeybind.Name
	end

	if waitingForESPKey then
		espKeyButton.Text = "PRESS"
	else
		espKeyButton.Text = espKeybind.Name
	end

	if waitingForUIKey then
		uiKeyButton.Text = "PRESS"
	else
		uiKeyButton.Text = uiToggleKeybind.Name
	end

	if systemEnabled and validTarget(lockedTarget) then
		targetLabel.Text =
			"Target: "
			.. lockedTarget.DisplayName
			.. "  (@"
			.. lockedTarget.Name
			.. ")"
		targetLabel.TextColor3 = COLORS.Text
	else
		targetLabel.Text = "Target: None"
		targetLabel.TextColor3 = COLORS.TextDim
	end
end

