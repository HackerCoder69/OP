------------------------------------------------------------

RunService.RenderStepped:Connect(function()

	if not systemEnabled then
		return
	end

	if not lockEnabled or not lockedTarget then
		return
	end

	if not validTarget(lockedTarget) then

		lockEnabled = false
		lockedTarget = nil

		updateUI()

		return
	end

	local character = lockedTarget.Character
	local head = character and getPart(character, "Head")

	if not head then

		lockEnabled = false
		lockedTarget = nil

		updateUI()

		return
	end

	local cameraPosition = camera.CFrame.Position

	camera.CFrame = CFrame.lookAt(
		cameraPosition,
		head.Position
	)

	targetLabel.Text =
		"Target: "
		.. lockedTarget.DisplayName
		.. "  (@"
		.. lockedTarget.Name
		.. ")"
end)

