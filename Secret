local function iconShape(parent, w, h, x, y, color, radius, outline)
	local f = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, x, 0.5, y),
		Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = color,
		BackgroundTransparency = outline and 1 or 0,
		BorderSizePixel = 0,
		Parent = parent,
	})
	if radius then
		corner(radius).Parent = f
	end
	if outline then
		create("UIStroke", { Color = color, Thickness = 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = f })
	end
	return f
end

