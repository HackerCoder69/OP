local function setRange(value)
	local v = clampNumber(value, Limits.Range.Min, Limits.Range.Max)
	if not v or State.Unloaded then
		emit("Range", State.Range)
		return
	end
	if v ~= State.Range then
		State.Range = v
		if State.ESP then
			refreshESP()
		end
	end
	emit("Range", State.Range)
end

