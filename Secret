local function setupPlayer(target)
	if target == player then
		return
	end

	local function setupCharacter(character)

		removeESP(target)

		local head = character:WaitForChild("Head", 5)

		if head then
			createESP(target)
		end
	end

	target.CharacterAdded:Connect(setupCharacter)

	target.CharacterRemoving:Connect(function()
		removeESP(target)

		if lockedTarget == target then
			lockedTarget = nil
			lockEnabled = false
		end

		updateUI()
	end)

	target:GetPropertyChangedSignal("Team"):Connect(function()

		if lockedTarget == target and isTeammate(target) then
			lockedTarget = nil
			lockEnabled = false
		end

		updateUI()
	end)

	if target.Character then
		task.spawn(function()
			setupCharacter(target.Character)
		end)
	end
end

