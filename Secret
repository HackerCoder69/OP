local function makeToggle(parent, position, signalName, getValue, onActivate)
	local track = create("TextButton", {
		Name = "Toggle",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = position,
		Size = UDim2.fromOffset(38, 22),
		BackgroundColor3 = Theme.Disabled,
		AutoButtonColor = false,
		Text = "",
		BorderSizePixel = 0,
		Parent = parent,
	}, { corner(11) })
	local trackStroke = stroke(Theme.Border)
	trackStroke.Parent = track
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = Theme.KnobOff,
		BorderSizePixel = 0,
		Parent = track,
	}, { corner(8) })

	local hovered, pressed = false, false
	local function render(instant)
		local on = getValue()
		local width = pressed and 20 or 16
		local x = on and (38 - 3 - width) or 3
		local trackProps = {
			BackgroundColor3 = on and Theme.Accent or (hovered and Theme.DisabledHover or Theme.Disabled),
		}
		local strokeProps = { Transparency = on and 1 or 0 }
		local knobProps = {
			Position = UDim2.new(0, x, 0.5, 0),
			Size = UDim2.fromOffset(width, 16),
			BackgroundColor3 = on and Theme.White or Theme.KnobOff,
		}
		if instant then
			for k, v in pairs(trackProps) do track[k] = v end
			for k, v in pairs(strokeProps) do trackStroke[k] = v end
			for k, v in pairs(knobProps) do knob[k] = v end
		else
			tween(track, 0.2, trackProps, "state")
			tween(trackStroke, 0.2, strokeProps, "state")
			tween(knob, 0.22, knobProps, "state")
		end
	end

	connect(track.MouseEnter, function()
		hovered = true
		render(false)
	end)
	connect(track.MouseLeave, function()
		hovered, pressed = false, false
		render(false)
	end)
	connect(track.MouseButton1Down, function()
		pressed = true
		render(false)
	end)
	connect(track.MouseButton1Up, function()
		pressed = false
		render(false)
	end)
	connect(track.Activated, function()
		pressed = false
		onActivate()
	end)
	subscribe(signalName, function()
		render(false)
	end)
	render(true)
	return track
end

local function makeSlider(parent, opts)
	local row = create("Frame", {
		Name = "Slider",
		Position = opts.Position,
		Size = UDim2.new(1, -24, 0, 22),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	local hit = create("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -58, 1, 0),
		Parent = row,
	})
	local track = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, 0, 0, 4),
		BackgroundColor3 = Theme.Track,
		BorderSizePixel = 0,
		Parent = hit,
	}, { corner(2) })
	local fill = create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Parent = track,
	}, { corner(2) })
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(12, 12),
		BackgroundColor3 = Theme.White,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = track,
	}, { corner(6) })
	local knobStroke = stroke(Theme.Accent, 0, 2)
	knobStroke.Parent = knob
	local knobScale = create("UIScale", { Parent = knob })

	local box = create("TextBox", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(46, 22),
		BackgroundColor3 = Theme.Secondary,
		BorderSizePixel = 0,
		Font = Fonts.Bold,
		TextSize = 11,
		TextColor3 = Theme.Text,
		PlaceholderColor3 = Theme.SubText,
		ClearTextOnFocus = false,
		Text = "",
		Parent = row,
	}, { corner(6) })
	local boxStroke = stroke(Theme.Border)
	boxStroke.Parent = box

	local function render(instant)
		local value = opts.Get()
		local alpha = (value - opts.Min) / (opts.Max - opts.Min)
		local enabled = (opts.IsEnabled == nil) or opts.IsEnabled()
		local color = enabled and Theme.Accent or Theme.KnobOff
		if instant then
			fill.Size = UDim2.fromScale(alpha, 1)
			fill.BackgroundColor3 = color
			knob.Position = UDim2.fromScale(alpha, 0.5)
			knobStroke.Color = color
		else
			tween(fill, 0.09, { Size = UDim2.fromScale(alpha, 1) }, "value")
			tween(knob, 0.09, { Position = UDim2.fromScale(alpha, 0.5) }, "value")
			tween(fill, 0.18, { BackgroundColor3 = color }, "color")
			tween(knobStroke, 0.18, { Color = color }, "color")
		end
		if not box:IsFocused() then
			box.Text = tostring(value)
		end
	end

	local function updateFromX(x)
		local width = track.AbsoluteSize.X
		if width <= 0 then
			return
		end
		local alpha = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
		opts.Set(opts.Min + alpha * (opts.Max - opts.Min))
	end

	connect(hit.InputBegan, function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			ActiveSlider = {
				Update = updateFromX,
				Release = function()
					tween(knobScale, 0.14, { Scale = 1 }, "press")
				end,
			}
			tween(knobScale, 0.14, { Scale = 1.25 }, "press")
			updateFromX(input.Position.X)
		end
	end)
	connect(hit.MouseEnter, function()
		tween(track, 0.15, { BackgroundColor3 = Theme.BorderLight }, "hover")
	end)
	connect(hit.MouseLeave, function()
		tween(track, 0.2, { BackgroundColor3 = Theme.Track }, "hover")
	end)

	connect(box:GetPropertyChangedSignal("Text"), function()
		local cleaned = (box.Text:gsub("%D", "")):sub(1, 4)
		if cleaned ~= box.Text then
			box.Text = cleaned
		end
	end)
	connect(box.Focused, function()
		tween(boxStroke, 0.15, { Color = Theme.Accent }, "focus")
	end)
	connect(box.FocusLost, function()
		tween(boxStroke, 0.2, { Color = Theme.Border }, "focus")
		local number = tonumber(box.Text)
		if number then
			opts.Set(number)
		end
		box.Text = tostring(opts.Get())
	end)

	subscribe(opts.Signal, function()
		render(false)
	end)
	if opts.EnabledSignal then
		subscribe(opts.EnabledSignal, function()
			render(false)
		end)
	end
	render(true)
	return row
end

