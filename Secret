------------------------------------------------------------------------
-- Toast notifications & window scaling (UI built later, guarded by UI table)
------------------------------------------------------------------------
local toastToken = 0
local TOAST_SHOWN = UDim2.new(0.5, 0, 1, -(FOOTER_H + 2))
local TOAST_HIDDEN = UDim2.new(0.5, 0, 1, -(FOOTER_H - 6))

local function toast(message, color)
	if State.Unloaded or not UI.Toast then
		return
	end
	toastToken = toastToken + 1
	local token = toastToken
	UI.ToastLabel.Text = message
	UI.ToastDot.BackgroundColor3 = color or Theme.Accent
	tween(UI.Toast, 0.2, { BackgroundTransparency = 0, Position = TOAST_SHOWN }, "toast")
	tween(UI.ToastLabel, 0.2, { TextTransparency = 0 }, "toast")
	tween(UI.ToastStroke, 0.2, { Transparency = 0 }, "toast")
	tween(UI.ToastDot, 0.2, { BackgroundTransparency = 0 }, "toast")
	schedule(2.2, function()
		if token ~= toastToken or not UI.Toast then
			return
		end
		tween(UI.Toast, 0.25, { BackgroundTransparency = 1, Position = TOAST_HIDDEN }, "toast")
		tween(UI.ToastLabel, 0.25, { TextTransparency = 1 }, "toast")
		tween(UI.ToastStroke, 0.25, { Transparency = 1 }, "toast")
		tween(UI.ToastDot, 0.25, { BackgroundTransparency = 1 }, "toast")
	end)
end

local Camera = nil

local function getBaseScale()
	if Camera then
		local vp = Camera.ViewportSize
		if vp.X > 0 and vp.Y > 0 then
			return math.clamp(math.min((vp.X - 40) / WINDOW_W, (vp.Y - 40) / WINDOW_H), 0.5, 1)
		end
	end
	return 1
end

local function refreshScale()
	if UI.HolderScale and State.MainReady and State.UIVisible then
		tween(UI.HolderScale, VISIBILITY_TIME, { Scale = getBaseScale() }, "vis")
	end
end

------------------------------------------------------------------------
-- Camera & FOV controller
------------------------------------------------------------------------
local OriginalFov = 70
local CameraConns = {}

local function applyFov(instant)
	local cam = Camera
	if not cam or not State.FovEnabled or State.Unloaded then
		return
	end
	if instant then
		cancelTween(cam, "fov")
		cam.FieldOfView = State.FOV
	else
		tween(cam, 0.14, { FieldOfView = State.FOV }, "fov", Enum.EasingStyle.Sine)
	end
end

local function restoreFov()
	local cam = Camera
	if cam then
		cancelTween(cam, "fov")
		cam.FieldOfView = OriginalFov
	end
end

local function hookCamera(cam)
	for _, c in ipairs(CameraConns) do
		c:Disconnect()
	end
	CameraConns = {}
	if Camera and Camera ~= cam then
		cancelTween(Camera, "fov")
	end
	Camera = cam
	if not cam then
		return
	end
	OriginalFov = cam.FieldOfView
	table.insert(CameraConns, cam:GetPropertyChangedSignal("ViewportSize"):Connect(refreshScale))
	applyFov(false)
	refreshScale()
end

local function setFovEnabled(enabled)
	enabled = enabled and true or false
	if State.Unloaded or enabled == State.FovEnabled then
		return
	end
	State.FovEnabled = enabled
	if enabled then
		applyFov(false)
	elseif Camera then
		tween(Camera, 0.14, { FieldOfView = OriginalFov }, "fov", Enum.EasingStyle.Sine)
	end
	emit("FovEnabled", enabled)
end

local function setFOV(value)
	local v = clampNumber(value, Limits.FOV.Min, Limits.FOV.Max)
	if not v or State.Unloaded then
		emit("FOV", State.FOV)
		return
	end
	if v ~= State.FOV then
		State.FOV = v
		applyFov(false)
	end
	emit("FOV", State.FOV)
end

------------------------------------------------------------------------
-- Player helpers
------------------------------------------------------------------------
local function getCharacterParts(player)
	local character = player.Character
	if not character or not character.Parent then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local head = character:FindFirstChild("Head")
	if not humanoid or humanoid.Health <= 0 or not head or not head:IsA("BasePart") then
		return nil
	end
	return character, humanoid, head
end

local function getOrigin()
	local character = LocalPlayer.Character
	local root = character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head"))
	if root and root:IsA("BasePart") then
		return root.Position
	end
	return Camera and Camera.CFrame.Position or nil
end

------------------------------------------------------------------------
-- Camlock
------------------------------------------------------------------------
local Camlock = { Target = nil, Character = nil, AimPos = nil, Conns = {} }
local setCamlock

local function stopCamlockTracking()
	pcall(function()
		RunService:UnbindFromRenderStep(CAMLOCK_BIND)
	end)
	for _, c in ipairs(Camlock.Conns) do
		c:Disconnect()
	end
	Camlock.Conns = {}
	Camlock.Target = nil
	Camlock.Character = nil
	Camlock.AimPos = nil
end

local function findCamlockTarget()
	local cam = Camera
	local origin = getOrigin()
	if not cam or not origin then
		return nil
	end
	local vp = cam.ViewportSize
	local center = Vector2.new(vp.X / 2, vp.Y / 2)
	local best, bestDistance = nil, math.huge
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local character, _, head = getCharacterParts(player)
			if character and (head.Position - origin).Magnitude <= State.Range then
				local screen, onScreen = cam:WorldToViewportPoint(head.Position)
				if onScreen then
					local d = (Vector2.new(screen.X, screen.Y) - center).Magnitude
					if d < bestDistance then
						best, bestDistance = player, d
					end
				end
			end
		end
	end
	return best
end

local function camlockStep(dt)
	-- Hard guard: the step never touches the camera unless Camlock is truly active
	if State.Unloaded or not State.Camlock or not Camlock.Target then
		pcall(function()
			RunService:UnbindFromRenderStep(CAMLOCK_BIND)
		end)
		return
	end
	local target = Camlock.Target
	if target.Parent ~= Players then
		setCamlock(false, "Target left the game")
		return
	end
	local character, _, head = getCharacterParts(target)
	if not character or character ~= Camlock.Character then
		setCamlock(false, "Target is no longer available")
		return
	end
	local origin = getOrigin()
	local distance = origin and (head.Position - origin).Magnitude or 0
	if distance > State.Range then
		setCamlock(false, "Target moved out of range")
		return
	end
	local cam = Camera
	if not cam then
		return
	end
	-- Instant lock: no smoothing, snap directly to the head position
	local camPos = cam.CFrame.Position
	if (head.Position - camPos).Magnitude > 0.05 then
		cam.CFrame = CFrame.lookAt(camPos, head.Position)
	end
end

setCamlock = function(enabled, reason)
	enabled = enabled and true or false
	if State.Unloaded or enabled == State.Camlock then
		return
	end
	if enabled then
		local target = findCamlockTarget()
		local character, humanoid, head
		if target then
			character, humanoid, head = getCharacterParts(target)
		end
		if not character then
			emit("Camlock", false)
			toast("No target in range", Theme.SubText)
			return
		end
		State.Camlock = true
		Camlock.Target = target
		Camlock.Character = character
		local cam = Camera
		if cam then
			local camPos = cam.CFrame.Position
			Camlock.AimPos = head.Position
		end
		table.insert(Camlock.Conns, humanoid.Died:Connect(function()
			setCamlock(false, "Target died")
		end))
		table.insert(Camlock.Conns, target.CharacterRemoving:Connect(function()
			setCamlock(false, "Target respawned")
		end))
		table.insert(Camlock.Conns, character.AncestryChanged:Connect(function(_, parent)
			if not parent then
				setCamlock(false, "Target is no longer available")
			end
		end))
		RunService:BindToRenderStep(CAMLOCK_BIND, Enum.RenderPriority.Camera.Value + 1, camlockStep)
		emit("Camlock", true)
		toast("Locked on " .. target.DisplayName)
	else
		State.Camlock = false
		stopCamlockTracking()
		emit("Camlock", false)
		if reason then
			toast("Camlock off · " .. reason, Theme.SubText)
		end
	end
end

------------------------------------------------------------------------
-- ESP
------------------------------------------------------------------------
local ESP = { Entries = {}, Conn = nil, Accumulator = 0 }

local function removeEspEntry(player)
	local entry = ESP.Entries[player]
	if not entry then
		return
	end
	ESP.Entries[player] = nil
	pcall(function()
		entry.Highlight:Destroy()
	end)
	pcall(function()
		entry.Billboard:Destroy()
	end)
end

local function createEspEntry(player, character, head)
	local highlight = create("Highlight", {
		Name = ESP_HIGHLIGHT_NAME,
		Adornee = character,
		FillColor = Theme.Accent,
		FillTransparency = 0.78,
		OutlineColor = Theme.Accent,
		OutlineTransparency = 0.05,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
		Parent = character,
	})
	local billboard = create("BillboardGui", {
		Name = ESP_TAG_NAME,
		Adornee = head,
		AlwaysOnTop = true,
		LightInfluence = 0,
		Size = UDim2.fromOffset(90, 24),
		StudsOffset = Vector3.new(0, 2.4, 0),
		ResetOnSpawn = false,
		Parent = head,
	})
	local pill = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(0, 20),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Theme.Background,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		Parent = billboard,
	}, {
		corner(6),
		stroke(Theme.Accent, 0.55),
		padding(0, 8, 0, 8),
	})
	local distanceLabel = label({
		Text = "",
		TextSize = 10,
		Font = Fonts.Medium,
		TextColor3 = Theme.Text,
		Size = UDim2.fromOffset(0, 20),
		AutomaticSize = Enum.AutomaticSize.X,
		TextTruncate = Enum.TextTruncate.None,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = pill,
	})
	local entry = { Highlight = highlight, Billboard = billboard, Character = character, Distance = distanceLabel }
	ESP.Entries[player] = entry
	return entry
end

local function refreshESP()
	if not State.ESP or State.Unloaded then
		return
	end
	local origin = getOrigin()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local character, _, head = getCharacterParts(player)
			local distance = (character and origin) and (head.Position - origin).Magnitude or nil
			if distance and distance <= State.Range then
				local entry = ESP.Entries[player]
				if entry and (entry.Character ~= character or not entry.Highlight.Parent or not entry.Billboard.Parent) then
					removeEspEntry(player)
					entry = nil
				end
				if not entry then
					entry = createEspEntry(player, character, head)
				end
				entry.Distance.Text = string.format("%d studs", math.floor(distance))
			else
				removeEspEntry(player)
			end
		end
	end
	for player in pairs(ESP.Entries) do
		if player.Parent ~= Players then
			removeEspEntry(player)
		end
	end
end

local function stopESP()
	if ESP.Conn then
		ESP.Conn:Disconnect()
		ESP.Conn = nil
	end
	for player in pairs(ESP.Entries) do
		removeEspEntry(player)
	end
	ESP.Accumulator = 0
end

local function setESP(enabled)
	enabled = enabled and true or false
	if State.Unloaded or enabled == State.ESP then
		return
	end
	State.ESP = enabled
	if enabled then
		ESP.Accumulator = 0
		ESP.Conn = RunService.Heartbeat:Connect(function(dt)
			if State.Unloaded or not State.ESP then
				return
			end
			ESP.Accumulator = ESP.Accumulator + dt
			if ESP.Accumulator >= ESP_REFRESH then
				ESP.Accumulator = 0
				refreshESP()
			end
		end)
		emit("ESP", true)
		refreshESP()
	else
		stopESP()
		emit("ESP", false)
	end
end

