script.Destroying:Connect(function()

	-- Reset camera FOV
	camera.FieldOfView = DEFAULT_FOV

	-- Remove all ESP
	for target, data in pairs(ESPObjects) do

		if data.gui then
			data.gui:Destroy()
		end

		ESPObjects[target] = nil
	end

	-- Remove any leftover splash
	if CoreGui:FindFirstChild("AdvancedPlayerSplash") then
		CoreGui.AdvancedPlayerSplash:Destroy()
	end
	if playerGui:FindFirstChild("AdvancedPlayerSplash") then
		playerGui.AdvancedPlayerSplash:Destroy()
	end

	-- Remove any leftover blur
	for _, effect in ipairs(camera:GetChildren()) do
		if effect:IsA("BlurEffect") and effect.Name == "SplashBlur" then
			effect:Destroy()
		end
	end

	if gui then
		gui:Destroy()
	end
end)

