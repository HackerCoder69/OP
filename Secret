-- Global table shared between executions (getgenv when available, otherwise shared)
local GlobalEnv = (type(getgenv) == "function" and getgenv()) or shared

local ESP_HIGHLIGHT_NAME = "DigitalServicesESP"
local ESP_TAG_NAME = "DigitalServicesESPTag"
local GUI_NAMES = { DigitalServicesGreeting = true, DigitalServicesInterface = true }
local CAMLOCK_BIND = "DigitalServicesCamlockStep"

-- Removes anything this script could have left behind (used on start and on unload)
local function sweepLeftovers(includeGuis)
	pcall(function()
		RunService:UnbindFromRenderStep(CAMLOCK_BIND)
	end)
	for _, child in ipairs(PlayerGui:GetChildren()) do
		if includeGuis and GUI_NAMES[child.Name] then
			pcall(function()
				child:Destroy()
			end)
		end
	end
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		if character then
			for _, d in ipairs(character:GetDescendants()) do
				if d.Name == ESP_HIGHLIGHT_NAME or d.Name == ESP_TAG_NAME then
					pcall(function()
						d:Destroy()
					end)
				end
			end
		end
	end
end

-- Unload a previously running copy so GUIs and listeners never duplicate
if type(GlobalEnv.DigitalServicesUnload) == "function" then
	pcall(GlobalEnv.DigitalServicesUnload, true)
end
sweepLeftovers(true)

