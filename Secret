local draggingSlider = false

local function setFovFromPosition(mouseX)
	if not systemEnabled then
		return
	end

	local trackAbsPos = sliderTrack.AbsolutePosition.X
	local trackWidth = sliderTrack.AbsoluteSize.X

	if trackWidth <= 0 then
		return
	end

	local alpha = (mouseX - trackAbsPos) / trackWidth
	alpha = math.clamp(alpha, 0, 1)

	currentFov = MIN_FOV + alpha * (MAX_FOV - MIN_FOV)
	updateFovSlider()
end

sliderHit.InputBegan:Connect(function(input)
	if not systemEnabled then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		draggingSlider = true
		setFovFromPosition(input.Position.X)
		TweenService:Create(sliderDot, TweenInfo.new(0.12), {Size = UDim2.new(0, 18, 0, 18)}):Play()
		TweenService:Create(sliderDotGlow, TweenInfo.new(0.12), {Transparency = 0.4}):Play()

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				draggingSlider = false
				TweenService:Create(sliderDot, TweenInfo.new(0.12), {Size = UDim2.new(0, 15, 0, 15)}):Play()
				TweenService:Create(sliderDotGlow, TweenInfo.new(0.12), {Transparency = 0.65}):Play()
			end
		end)
	end
end)

sliderTrack.InputBegan:Connect(function(input)
	if not systemEnabled then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		draggingSlider = true
		setFovFromPosition(input.Position.X)

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				draggingSlider = false
			end
		end)
	end
end)

UIS.InputChanged:Connect(function(input)
	if draggingSlider and systemEnabled and (input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then
		setFovFromPosition(input.Position.X)
	end
end)

