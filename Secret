local function toggleCamLock()

	if not systemEnabled then
		return
	end

	if lockEnabled then

		lockEnabled = false
		lockedTarget = nil

	else

		local target = closestTarget()

		if target then
			lockedTarget = target
			lockEnabled = true
		else
			lockedTarget = nil
			lockEnabled = false
		end
	end

	updateUI()
end

------------------------------------------------------------
-- TOGGLE ESP
------------------------------------------------------------

local function toggleESP()

	if not systemEnabled then
		return
	end

	espEnabled = not espEnabled

	if not espEnabled then

		for _, data in pairs(ESPObjects) do

			if data.gui then
				data.gui.Enabled = false
			end
		end
	end

	updateUI()
end

