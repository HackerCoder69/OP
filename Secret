rangeInput.FocusLost:Connect(function()
	TweenService:Create(rangeInputStroke, TweenInfo.new(0.15), {Color = COLORS.BorderLight}):Play()

	if not systemEnabled then
		rangeInput.Text = tostring(MAX_DISTANCE)
		return
	end

	local num = tonumber(rangeInput.Text)

	if not num then
		rangeInput.Text = tostring(MAX_DISTANCE)
		return
	end

	num = math.floor(num)
	num = math.clamp(num, MIN_DISTANCE, MAX_DISTANCE_LIMIT)
	MAX_DISTANCE = num
	rangeInput.Text = tostring(num)

	updateUI()
end)

------------------------------------------------------------
-- KEYBOARD
------------------------------------------------------------

UIS.InputBegan:Connect(function(input, gameProcessed)

	if gameProcessed then
		return
	end

	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end

	--------------------------------------------------------
	-- WAITING FOR UI TOGGLE KEY (highest priority)
	--------------------------------------------------------

	if waitingForUIKey then
		if input.KeyCode ~= Enum.KeyCode.Unknown then
			uiToggleKeybind = input.KeyCode
			waitingForUIKey = false
			updateUI()
		end
		return
	end

	--------------------------------------------------------
	-- TOGGLE UI VISIBILITY
	--------------------------------------------------------

	if input.KeyCode == uiToggleKeybind then
		uiVisible = not uiVisible

		if uiVisible then
			main.Visible = true
			main.Size = UDim2.new(0, 340, 0, 430)

			TweenService:Create(main, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
				Size = UDim2.new(0, 365, 0, 458)
			}):Play()
		else
			TweenService:Create(main, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
				Size = UDim2.new(0, 340, 0, 430)
			}):Play()

			task.delay(0.2, function()
				main.Visible = false
				main.Size = UDim2.new(0, 365, 0, 458)
			end)
		end
		return
	end

	if not systemEnabled then
		return
	end

	--------------------------------------------------------
	-- CHANGE CAM KEY
	--------------------------------------------------------

	if waitingForCamKey then

		if input.KeyCode ~= Enum.KeyCode.Unknown then

			camKeybind = input.KeyCode
			waitingForCamKey = false

			updateUI()
		end

		return
	end

	--------------------------------------------------------
	-- CHANGE ESP KEY
	--------------------------------------------------------

	if waitingForESPKey then

		if input.KeyCode ~= Enum.KeyCode.Unknown then

			espKeybind = input.KeyCode
			waitingForESPKey = false

			updateUI()
		end

		return
	end

	--------------------------------------------------------
	-- CAM LOCK
	--------------------------------------------------------

	if input.KeyCode == camKeybind then
		toggleCamLock()
		return
	end

	--------------------------------------------------------
	-- ESP
	--------------------------------------------------------

	if input.KeyCode == espKeybind then
		toggleESP()
		return
	end
end)

