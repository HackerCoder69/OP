local currentFov = MIN_FOV

local function updateFovSlider()
	local alpha = (currentFov - MIN_FOV) / (MAX_FOV - MIN_FOV)
	alpha = math.clamp(alpha, 0, 1)

	sliderDot.Position = UDim2.new(alpha, 0, 0.5, 0)
	sliderHit.Position = UDim2.new(alpha, 0, 0.5, 0)
	sliderFill.Size = UDim2.new(alpha, 0, 1, 0)

	if systemEnabled then
		camera.FieldOfView = currentFov
	end
	fovValueLabel.Text = tostring(math.floor(currentFov + 0.5))
end

