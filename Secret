------------------------------------------------------------
-- HELPERS
------------------------------------------------------------

local function getPart(character, name)
	if not character then
		return nil
	end

	return character:FindFirstChild(name)
end

local function getHumanoid(character)
	if not character then
		return nil
	end

	return character:FindFirstChildOfClass("Humanoid")
end

local function getMyRoot()
	local character = player.Character

	if not character then
		return nil
	end

	return getPart(character, "HumanoidRootPart")
end

local function getDistance(target)
	local myRoot = getMyRoot()

	if not myRoot then
		return math.huge
	end

	local character = target.Character
	local root = character and getPart(character, "HumanoidRootPart")

	if not root then
		return math.huge
	end

	return (root.Position - myRoot.Position).Magnitude
end

------------------------------------------------------------
-- TEAM CHECK
------------------------------------------------------------

local function isTeammate(target)
	if not target or target == player then
		return false
	end

	if player.Team ~= nil and target.Team ~= nil then
		return player.Team == target.Team
	end

	return false
end

------------------------------------------------------------
-- VALID CAM LOCK TARGET
------------------------------------------------------------

local function validTarget(target)
	if not target or target == player then
		return false
	end

	if isTeammate(target) then
		return false
	end

	local character = target.Character

	if not character then
		return false
	end

	local humanoid = getHumanoid(character)
	local head = getPart(character, "Head")
	local root = getPart(character, "HumanoidRootPart")

	if not humanoid or humanoid.Health <= 0 then
		return false
	end

	if not head or not root then
		return false
	end

	if getDistance(target) > MAX_DISTANCE then
		return false
	end

	return true
end

------------------------------------------------------------
-- CLOSEST TARGET
------------------------------------------------------------

local function closestTarget()
	local best = nil
	local bestDistance = math.huge

	local center = Vector2.new(
		camera.ViewportSize.X / 2,
		camera.ViewportSize.Y / 2
	)

	for _, target in ipairs(Players:GetPlayers()) do
		if validTarget(target) then
			local character = target.Character
			local head = getPart(character, "Head")

			if head then
				local screenPosition, visible =
					camera:WorldToViewportPoint(head.Position)

				if visible and screenPosition.Z > 0 then
					local screenDistance =
						(
							Vector2.new(
								screenPosition.X,
								screenPosition.Y
							) - center
						).Magnitude

					if screenDistance < bestDistance then
						bestDistance = screenDistance
						best = target
					end
				end
			end
		end
	end

	return best
end

