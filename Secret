------------------------------------------------------------
-- UI TOGGLE (JUICY ANIMATION)
------------------------------------------------------------

local uiAnimating = false

-- Store original background transparencies of all rows for stagger restore
local allRows = {
	{obj = topBar,          transparency = 0.25},
	{obj = status,          transparency = 1},
	{obj = camFrame,        transparency = 0},
	{obj = espFrame,        transparency = 0},
	{obj = rangeRow,        transparency = 0},
	{obj = fovRow,          transparency = 0},
	{obj = uiRow,           transparency = 0},
	{obj = targetContainer, transparency = 0},
	{obj = systemButton,    transparency = 0},
}

local function toggleUIVisibility()
	if uiAnimating then
		return
	end

	uiAnimating = true
	uiVisible = not uiVisible

	local currentPos = main.Position

	if uiVisible then
		--------------------------------------------------------
		-- SHOW: juicy overshoot pop-in
		--------------------------------------------------------

		main.Visible = true

		-- Set starting "squashed" state - small, tilted feel, transparent, offset
		main.Size = UDim2.new(0, 200, 0, 260)
		main.BackgroundTransparency = 1
		main.Position = UDim2.new(
			currentPos.X.Scale,
			currentPos.X.Offset + 30,
			currentPos.Y.Scale,
			currentPos.Y.Offset + 25
		)

		-- Shadow starts dark and small
		shadow.BackgroundTransparency = 1
		shadow.Size = UDim2.new(1, -20, 1, -20)
		shadow.Position = UDim2.new(0.5, 0, 0.5, 0)

		-- Hide all rows initially for staggered cascade
		for _, row in ipairs(allRows) do
			row.obj.BackgroundTransparency = 1
		end

		title.TextTransparency = 1
		subtitle.TextTransparency = 1
		accentDot.BackgroundTransparency = 1

		title.Position = UDim2.new(0, 12, 0, 10)
		subtitle.Position = UDim2.new(0, 12, 0, 33)

		closeButton.BackgroundTransparency = 1
		closeStroke.Transparency = 1

		mainStroke.Transparency = 1

		--------------------------------------------------------
		-- MAIN POP (bouncy overshoot)
		--------------------------------------------------------

		local showMain = TweenService:Create(
			main,
			TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{
				Size = UDim2.new(0, 372, 0, 466),
				Position = currentPos,
				BackgroundTransparency = 0
			}
		)

		showMain:Play()

		-- Shadow expands + darkens for depth
		TweenService:Create(
			shadow,
			TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{
				Size = UDim2.new(1, 0, 1, 0),
				BackgroundTransparency = 0.7
			}
		):Play()

		-- Border reveals
		TweenService:Create(
			mainStroke,
			TweenInfo.new(0.35),
			{Transparency = 0.45}
		):Play()

		-- Title + subtitle slide in from left with Quart ease
		TweenService:Create(
			title,
			TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
			{TextTransparency = 0, Position = UDim2.new(0, 36, 0, 10)}
		):Play()

		TweenService:Create(
			subtitle,
			TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
			{TextTransparency = 0, Position = UDim2.new(0, 36, 0, 33)}
		):Play()

		TweenService:Create(
			accentDot,
			TweenInfo.new(0.4),
			{BackgroundTransparency = 0}
		):Play()

		-- Close button
		TweenService:Create(
			closeButton,
			TweenInfo.new(0.35),
			{BackgroundTransparency = 0}
		):Play()

		TweenService:Create(
			closeStroke,
			TweenInfo.new(0.35),
			{Transparency = 0.3}
		):Play()

		--------------------------------------------------------
		-- STAGGERED ROW CASCADE (top to bottom)
		--------------------------------------------------------

		for i, row in ipairs(allRows) do
			task.delay(0.12 + (i - 1) * 0.035, function()
				if not uiVisible then return end

				TweenService:Create(
					row.obj,
					TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
					{BackgroundTransparency = row.transparency}
				):Play()
			end)
		end

		showMain.Completed:Wait()

		-- Small "settle" pulse on the shadow for juice
		if uiVisible then
			TweenService:Create(
				shadow,
				TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
				{BackgroundTransparency = 0.78}
			):Play()
		end

		uiAnimating = false
	else
		--------------------------------------------------------
		-- HIDE: juicy scale-down + cascade out
		--------------------------------------------------------

		--------------------------------------------------------
		-- CASCADE ROWS OUT (top to bottom quickly)
		--------------------------------------------------------

		for i, row in ipairs(allRows) do
			task.delay((i - 1) * 0.02, function()
				TweenService:Create(
					row.obj,
					TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
					{BackgroundTransparency = 1}
				):Play()
			end)
		end

		-- Fade title elements
		TweenService:Create(
			title,
			TweenInfo.new(0.15),
			{TextTransparency = 1}
		):Play()

		TweenService:Create(
			subtitle,
			TweenInfo.new(0.15),
			{TextTransparency = 1}
		):Play()

		TweenService:Create(
			accentDot,
			TweenInfo.new(0.15),
			{BackgroundTransparency = 1}
		):Play()

		TweenService:Create(
			closeButton,
			TweenInfo.new(0.15),
			{BackgroundTransparency = 1}
		):Play()

		TweenService:Create(
			closeStroke,
			TweenInfo.new(0.15),
			{Transparency = 1}
		):Play()

		TweenService:Create(
			mainStroke,
			TweenInfo.new(0.25),
			{Transparency = 1}
		):Play()

		-- Shadow shrinks and fades
		TweenService:Create(
			shadow,
			TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{
				Size = UDim2.new(1, -20, 1, -20),
				BackgroundTransparency = 1
			}
		):Play()

		-- Main shrinks and fades with a "suck in" feel
		local hideMain = TweenService:Create(
			main,
			TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In),
			{
				Size = UDim2.new(0, 200, 0, 260),
				Position = UDim2.new(
					currentPos.X.Scale,
					currentPos.X.Offset + 30,
					currentPos.Y.Scale,
					currentPos.Y.Offset + 25
				),
				BackgroundTransparency = 1
			}
		)

		hideMain:Play()
		hideMain.Completed:Wait()

		-- Reset everything for next show
		main.Visible = false
		main.Size = UDim2.new(0, 372, 0, 466)
		main.Position = currentPos
		main.BackgroundTransparency = 0

		for _, row in ipairs(allRows) do
			row.obj.BackgroundTransparency = row.transparency
		end

		title.Position = UDim2.new(0, 36, 0, 10)
		subtitle.Position = UDim2.new(0, 36, 0, 33)
		title.TextTransparency = 0
		subtitle.TextTransparency = 0
		accentDot.BackgroundTransparency = 0

		closeButton.BackgroundTransparency = 0
		closeStroke.Transparency = 0.3

		mainStroke.Transparency = 0.45

		shadow.Size = UDim2.new(1, 0, 1, 0)
		shadow.BackgroundTransparency = 0.7

		uiAnimating = false
	end
end

